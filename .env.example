# INNOVATEX IDEATHON — Environment Variables

# ─────────────────────────────────────────────────────────
# SUPABASE (get from: https://supabase.com/dashboard/project/_/settings/api)
# ─────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─────────────────────────────────────────────────────────
# RAZORPAY — PUBLIC KEY ONLY (test mode starts with rzp_test_)
# Get from: https://dashboard.razorpay.com/app/keys
# NEVER put KEY_SECRET here — it belongs only in Supabase Edge Function secrets
# ─────────────────────────────────────────────────────────
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# ─────────────────────────────────────────────────────────
# SUPABASE EDGE FUNCTION SECRETS (set via Supabase Dashboard → Edge Functions → Secrets)
# These are NEVER placed in this file or any frontend file
# ─────────────────────────────────────────────────────────
# RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# RAZORPAY_KEY_SECRET=your_razorpay_secret_key
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
